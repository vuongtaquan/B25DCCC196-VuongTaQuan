
import java.util.*;

interface MienGiam {
    long tinhGiam(long hocPhi);
}

class ConChinhSach implements MienGiam {
    public long tinhGiam(long hocPhi) {
        return hocPhi / 2;
    }
}

class HoNgheo implements MienGiam {
    public long tinhGiam(long hocPhi) {
        return hocPhi * 70 / 100;
    }
}

class HocBong implements MienGiam {
    public long tinhGiam(long hocPhi) {
        return Math.min(3000000L, hocPhi);
    }
}

abstract class SinhVien {
    String maSV, he;
    int soTinChi;
    MienGiam mienGiam;

    SinhVien(String ma, String he, int tc) {
        maSV = ma;
        this.he = he;
        soTinChi = tc;
    }

    abstract long hocPhi();

    long tienGiam() {
        return mienGiam == null ? 0 : mienGiam.tinhGiam(hocPhi());
    }

    long phaiNop() {
        return hocPhi() - tienGiam();
    }
}

class ChinhQuy extends SinhVien {
    ChinhQuy(String ma, int tc) {
        super(ma, "CQ", tc);
    }

    long hocPhi() {
        return soTinChi * 450000L;
    }
}

class ChatLuongCao extends SinhVien {
    ChatLuongCao(String ma, int tc) {
        super(ma, "CLC", tc);
    }

    long hocPhi() {
        return (long)(soTinChi * 450000L * 1.5);
    }
}

class LienThong extends SinhVien {
    LienThong(String ma, int tc) {
        super(ma, "LT", tc);
    }

    long hocPhi() {
        return soTinChi * 450000L + 2000000L;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = Integer.parseInt(sc.nextLine());

        ArrayList<SinhVien> ds = new ArrayList<>();
        HashMap<String, SinhVien> map = new HashMap<>();

        for (int i = 0; i < n; i++) {
            String[] a = sc.nextLine().split("\\s+");

            SinhVien sv;

            if (a[0].equals("CQ"))
                sv = new ChinhQuy(a[1], Integer.parseInt(a[2]));
            else if (a[0].equals("CLC"))
                sv = new ChatLuongCao(a[1], Integer.parseInt(a[2]));
            else
                sv = new LienThong(a[1], Integer.parseInt(a[2]));

            ds.add(sv);
            map.put(sv.maSV, sv);
        }

        int m = Integer.parseInt(sc.nextLine());

        for (int i = 0; i < m; i++) {
            String[] a = sc.nextLine().split("\\s+");

            SinhVien sv = map.get(a[0]);

            if (sv == null) {
                System.out.println("NOT FOUND " + a[0]);
                continue;
            }

            switch (a[1]) {
                case "CS":
                    sv.mienGiam = new ConChinhSach();
                    break;
                case "HN":
                    sv.mienGiam = new HoNgheo();
                    break;
                case "HB":
                    sv.mienGiam = new HocBong();
                    break;
            }
        }

        long[] tong = new long[3];
        int[] dem = new int[3];

        for (SinhVien sv : ds) {
            System.out.println(sv.maSV + " " + sv.he + " "
                    + sv.hocPhi() + " " + sv.tienGiam()
                    + " " + sv.phaiNop());

            int k = sv.he.equals("CQ") ? 0
                    : sv.he.equals("CLC") ? 1 : 2;

            dem[k]++;
            tong[k] += sv.phaiNop();
        }

        String[] he = {"CQ", "CLC", "LT"};

        for (int i = 0; i < 3; i++) {
            if (dem[i] > 0)
                System.out.println(he[i] + " " + dem[i]
                        + " " + tong[i]);
        }
    }
}
